.ToolsGCP/config/
.ToolsGCP/privacy_policy.json
.ToolsGCP/logs/
.ToolsGCP/ToolsGCP-Resources.backup-*.json

# 本地导出的部署清单 / 资源稿件
ToolsGCP-Deploy-*.json
ResourceDrafts/

# 自检脚本的渲染产物（tools/detail_preview.py 生成，随时可重跑）
